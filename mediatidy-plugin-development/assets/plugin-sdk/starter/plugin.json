{
  "id": "example.directory-inventory",
  "name": "目录清单",
  "version": "0.1.0",
  "sdkVersion": "2",
  "author": "MediaTidy",
  "description": "只读扫描授权目录，等待后台扫描完成后生成并保存文件清单。演示任务关联、完成动作、存储和组件页面。",
  "entry": "plugin.py:Plugin",
  "permissions": [
    "files.read",
    "tasks.read",
    "tasks.cancel",
    "tasks.wait",
    "storage",
    "triggers.manage"
  ],
  "config": [],
  "actions": [
    {
      "id": "scan-files",
      "label": "扫描目录",
      "fields": [
        {
          "key": "files",
          "label": "文件或目录",
          "type": "files",
          "required": true
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "outputSchema": {}
    },
    {
      "id": "collect-report",
      "label": "收集完成结果",
      "fields": [],
      "kind": "continuation",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "outputSchema": {}
    },
    {
      "id": "show-report",
      "label": "查看已保存清单",
      "fields": [],
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "outputSchema": {}
    }
  ],
  "ui": {
    "mode": "python",
    "version": "2"
  },
  "configSchema": {
    "type": "object",
    "properties": {}
  },
  "queries": [
    {
      "id": "history",
      "label": "已保存清单",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {}
    }
  ],
  "triggers": []
}
