{
  "id": "example.react",
  "name": "React 交互组件示例",
  "version": "1.0.0",
  "sdkVersion": "2",
  "entry": "plugin.py:Plugin",
  "description": "模块联邦、共享 React 和第三方可调面板组件。",
  "author": "MediaTidy",
  "permissions": [
    "storage"
  ],
  "actions": [
    {
      "id": "increment",
      "label": "递增计数",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {}
    }
  ],
  "queries": [
    {
      "id": "history",
      "label": "计数",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {}
    }
  ],
  "ui": {
    "mode": "react",
    "version": "2",
    "entry": "ui/remoteEntry.js"
  }
}
