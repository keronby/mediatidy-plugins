{
  "id": "example.pillow",
  "name": "Pillow 图片缩放",
  "version": "1.0.0",
  "sdkVersion": "2",
  "entry": "plugin.py:Plugin",
  "description": "真正使用 Pillow wheel，读取、缩放、写回并预览图片。",
  "author": "MediaTidy",
  "permissions": [
    "files.read",
    "files.write",
    "storage",
    "tasks.read",
    "tasks.wait"
  ],
  "actions": [
    {
      "id": "resize",
      "label": "缩放图片",
      "fields": [
        {
          "key": "files",
          "label": "图片",
          "type": "files",
          "required": true
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "rootId": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 16,
            "maximum": 4096
          }
        },
        "required": [
          "rootId",
          "destination",
          "size"
        ]
      },
      "outputSchema": {}
    },
    {
      "id": "collect",
      "label": "接收图片写入结果",
      "kind": "continuation",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {}
    }
  ],
  "queries": [
    {
      "id": "latest",
      "label": "最近图片",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {}
    }
  ],
  "ui": {
    "mode": "python",
    "version": "2"
  }
}
