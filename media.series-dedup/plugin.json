    },
    {
      "id": "test-mt-mapping",
      "label": "测试MT云盘映射（只读）",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
