{
  "id": "media.series-dedup",
  "name": "影视查重",
  "version": "1.4.12",
  "sdkVersion": "2",
  "entry": "plugin.py:Plugin",
  "description": "智能扫描电影与电视剧目录，基于 TMDB 官方元数据识别多版本重复，按 STRM 链接属性（分享链/云盘链/混合链）自动分流重整任务。支持直接下拉选取整理方案。",
  "author": "keronby",
  "permissions": [
    "files.read",
    "storage",
    "organize.read",
    "tasks.read",
    "tasks.wait",
    "organize.manual.run",
    "files.delete",
    "tmdb.read",
    "rules.read"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "rootBindings": {
        "type": "array",
        "maxItems": 30,
        "items": {
          "type": "object",
          "properties": {
            "rootId": {
              "type": "string",
              "minLength": 1
            },
            "mountPath": {
              "type": "string",
              "minLength": 2
            }
          },
          "required": [
            "rootId",
            "mountPath"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "actions": [
    {
      "id": "scan",
      "label": "开始全量扫描与比对",
      "inputSchema": {
        "type": "object",
        "properties": {
          "localProfileId": {
            "type": "number"
          },
          "cloudProfileId": {
            "type": "number"
          },
          "tmdb_style": {
            "type": "string"
          },
          "scanPath": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "refresh-tmdb",
      "label": "重新查询 TMDB 元数据（非强制刷新）"
    },
    {
      "id": "save-config",
      "label": "保存工作台业务配置",
      "inputSchema": {
        "type": "object",
        "properties": {
          "localProfileId": {
            "type": "number"
          },
          "cloudProfileId": {
            "type": "number"
          },
          "localDestDir": {
            "type": "string"
          },
          "cloudDestDir": {
            "type": "string"
          },
          "strmLocalPrefix": {
            "type": "string"
          },
          "strmCloudPrefix": {
            "type": "string"
          },
          "tmdb_style": {
            "type": "string"
          },
          "tmdbStyle": {
            "type": "string"
          },
          "strm_local_prefix": {
            "type": "string"
          },
          "strm_cloud_prefix": {
            "type": "string"
          },
          "scanPath": {
            "type": "string",
            "minLength": 1
          },
          "qualityRuleId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "submit-organize",
      "label": "执行分流重整",
      "fields": [
        {
          "key": "confirm",
          "label": "确认提交批量重整任务",
          "type": "boolean",
          "default": false
        }
      ]
    },
    {
      "id": "submit-single",
      "label": "单项手动提交重整",
      "fields": [
        {
          "key": "localPath",
          "label": "本地目录路径",
          "type": "text"
        },
        {
          "key": "linkType",
          "label": "链接类型",
          "type": "text",
          "default": "http"
        },
        {
          "key": "strmSource",
          "label": "STRM 源地址",
          "type": "text"
        },
        {
          "key": "cloudnasPath",
          "label": "云盘对应源目录",
          "type": "text"
        },
        {
          "key": "profileId",
          "label": "整理方案ID",
          "type": "number"
        },
        {
          "key": "destDir",
          "label": "目标目录",
          "type": "text"
        },
        {
          "key": "mediaType",
          "label": "媒体类型",
          "type": "text",
          "default": "tv"
        },
        {
          "key": "tmdbId",
          "label": "TMDB ID",
          "type": "text"
        }
      ]
    },
    {
      "id": "clear",
      "label": "清空扫描结果与日志"
    },
    {
      "id": "delete-single",
      "label": "单项删除影视作品目录",
      "fields": [
        {
          "key": "localPath",
          "label": "本地目录路径",
          "type": "text"
        },
        {
          "key": "linkType",
          "label": "链接类型(http或cloudnas)",
          "type": "text",
          "default": "http"
        }
      ]
    },
    {
      "id": "batch-submit",
      "label": "批量提交选定条目重整",
      "fields": [
        {
          "key": "selectedPaths",
          "label": "选中的路径列表",
          "type": "stringList"
        },
        {
          "key": "linkType",
          "label": "链接类型",
          "type": "text",
          "default": "http"
        }
      ]
    },
    {
      "id": "batch-delete",
      "label": "批量彻底删除选定影视作品",
      "fields": [
        {
          "key": "selectedPaths",
          "label": "选中的路径列表",
          "type": "stringList"
        },
        {
          "key": "linkType",
          "label": "链接类型",
          "type": "text",
          "default": "http"
        }
      ]
    },
    {
      "id": "protect-item",
      "label": "将选定作品收入保护组",
      "fields": [
        {
          "key": "localPath",
          "label": "本地目录路径",
          "type": "text"
        },
        {
          "key": "tmdbId",
          "label": "TMDB ID",
          "type": "text"
        },
        {
          "key": "mediaType",
          "label": "媒体类型",
          "type": "text",
          "default": "tv"
        },
        {
          "key": "title",
          "label": "作品名称",
          "type": "text"
        },
        {
          "key": "dirName",
          "label": "目录名称",
          "type": "text"
        },
        {
          "key": "linkType",
          "label": "链接类型",
          "type": "text",
          "default": "http"
        }
      ]
    },
    {
      "id": "unprotect-item",
      "label": "将选定作品移出保护组",
      "fields": [
        {
          "key": "key",
          "label": "保护条目主键",
          "type": "text"
        },
        {
          "key": "localPath",
          "label": "本地目录路径",
          "type": "text"
        }
      ]
    },
    {
      "id": "check-protected-tmdb",
      "label": "批量向 TMDB 查验保护组年份",
      "fields": [
        {
          "key": "key",
          "label": "保护条目主键",
          "type": "text"
        }
      ]
    },
    {
      "id": "collect-delete",
      "label": "核对删除任务结果",
      "kind": "continuation",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "collect-organize",
      "label": "核对整理任务结果",
      "kind": "continuation",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "cleanup-snapshots",
      "label": "回收24小时前的旧快照分片",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "id": "preview-mixed",
      "label": "预览混合链接评分（不删除）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tmdbId": {
            "type": "integer",
            "minimum": 1
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "movie",
              "tv"
            ]
          },
          "ruleId": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "tmdbId",
          "mediaType",
          "ruleId"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "cleanup-mixed",
      "label": "按评分清理混合组败者文件",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tmdbId": {
            "type": "string"
          },
          "mediaType": {
            "type": "string",
            "enum": [
              "movie",
              "tv"
            ]
          }
        },
        "required": [
          "tmdbId",
          "mediaType"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "collect-mixed",
      "kind": "continuation",
      "label": "核对混合组文件清理结果",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "batch-cleanup-mixed",
      "label": "处理勾选混合组：清理败者并整理胜者",
      "inputSchema": {
        "type": "object",
        "properties": {
          "selectedGroups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "selectedGroups"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "resume-mixed",
      "label": "核验并续接混合处理（不重发未知删除）",
      "inputSchema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
